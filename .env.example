# --- App ---
PORT=4000
JWT_SECRET=change_this_to_a_long_random_string
SIGNUP_BONUS_CREDITS=10
CREDIT_COST_PER_MINUTE=1

# --- ws-scrcpy (already running per your setup) ---
WSSCRCPY_BASE_URL=http://192.168.4.124:8000
ADB_BIN=/usr/bin/adb

# --- Proxmox ---
PROXMOX_HOST=your-proxmox-ip-or-hostname
PROXMOX_PORT=8006
PROXMOX_NODE=pve
PROXMOX_TOKEN_ID=root@pam!vmstream
PROXMOX_TOKEN_SECRET=paste-your-api-token-secret-here
PROXMOX_VERIFY_TLS=false

# The VM ID of your existing Android VM, used as the clone source/template.
PROXMOX_TEMPLATE_VMID=123

# Range of VM IDs this app is allowed to create clones into (must not collide
# with anything else on your Proxmox node). Keep this small - each VMID needs
# a matching DHCP reservation on your router (see README "Networking"), and
# it also caps how many concurrent streaming sessions you can serve at once.
# With a 16GB host and 4GB per instance, ~3 concurrent is the realistic
# ceiling after leaving headroom for Proxmox itself - don't raise this range
# without adding more host RAM first.
PROXMOX_CLONE_VMID_START=9000
PROXMOX_CLONE_VMID_END=9002

# Each cloned VM gets a deterministic MAC address (derived from its VMID) and
# is expected to always receive the same IP for that MAC via a DHCP
# reservation on your router. STATIC_MAP_SUBNET + STATIC_MAP_OFFSET + (vmid -
# PROXMOX_CLONE_VMID_START) gives the IP - e.g. with the defaults below, VMID
# 9000 -> 192.168.4.150, VMID 9001 -> 192.168.4.151, VMID 9002 -> 192.168.4.152.
STATIC_MAP_SUBNET=192.168.4.
STATIC_MAP_OFFSET=150
